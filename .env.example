# Supabase project URL, publishable (or legacy anon) key and secret (or legacy service_role) key.
# These are SERVER-ONLY. Never add NEXT_PUBLIC_ to the secret key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
SUPABASE_SECRET_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY
# Set this to the final Vercel URL before enabling Google login.
APP_URL=http://localhost:3000
# Enable only after configuring the corresponding provider in Supabase.
GOOGLE_LOGIN_ENABLED=false
# Requires the OTP email template and custom SMTP for your roommates.
EMAIL_LOGIN_ENABLED=false
# Vercel build setting; pins the manager from package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
